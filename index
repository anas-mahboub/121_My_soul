  <button id="open-letter" class="pill-btn reveal">OPEN LETTER →</button>
</section>

<section class="scene" id="letter">
  <div class="wrap">
    <div>
      <div class="paper" id="letter-body"></div>
      <button id="next-mem" class="pill-btn reveal">NEXT →</button>
    </div>
  </div>
</section>

<section class="scene" id="memories">
  <div class="inner">
    <h2>📷 &nbsp;OUR MEMORIES</h2>
    <figure class="mem" style="--rot:-2.2deg"><img id="mem1" alt=""><figcaption>Have a wonderful day!</figcaption></figure>
    <figure class="mem" style="--rot:1.6deg"><img id="mem2" alt=""><figcaption>You're always amazing</figcaption></figure>
    <figure class="mem" style="--rot:-1.2deg"><img id="mem3" alt=""><figcaption>You make every day brighter ☀</figcaption></figure>
    <div class="from-me">FROM ME ♡</div>
    <button id="next-final" class="pill-btn">NEXT →</button>
  </div>
</section>

<section class="scene" id="final" data-phase="p1">
  <div class="stage">
    <span class="bar bl"></span>
    <span class="bar br"></span>
    <div class="layer l-heart"><span class="heart">♥</span></div>
    <div class="layer l-ihy"><span>I</span><span class="heart">♥</span><span>YOU</span></div>
    <div class="layer l-ily"><span>I&nbsp;LOVE&nbsp;YOU</span></div>
    <span class="ring"></span>
    <span class="dot d1"></span>
    <span class="dot d2"></span>
  </div>
</section>

<script>
// hey, if you're reading this code... hi, it's me. sorry it's messy, i'm not a programmer lol
const $=s=>document.querySelector(s);
let current='lock';

/* ============ THE SECRET WORD — change it to anything you both know ============ */
const PASSWORD='iloveyou';
const HINT='hint: the three words I always tell you ♡';
$('#lock-hint').textContent=HINT;
function tryUnlock(){
  const v=$('#pass').value.trim().toLowerCase();
  if(v===PASSWORD.toLowerCase()){
    $('#lock').classList.remove('active');
    show('home');
    setTimeout(()=>$('#open-letter').classList.add('show'),2600);
  }else{
    const c=$('#lock-card');c.classList.remove('shake');void c.offsetWidth;c.classList.add('shake');
    const e=$('#lock-err');e.textContent="that's not it, my love ♡ try again";e.style.opacity=1;
    setTimeout(()=>e.style.opacity=0,1800);
    $('#pass').value='';$('#pass').focus();
  }
}
$('#unlock').addEventListener('click',tryUnlock);
$('#pass').addEventListener('keydown',e=>{if(e.key==='Enter')tryUnlock();});

// stars
for(let i=0;i<110;i++){
  const s=document.createElement('i');s.className='star';
  const z=Math.random()*2+1;
  s.style.cssText=`left:${Math.random()*100}%;top:${Math.random()*100}%;width:${z}px;height:${z}px;animation-delay:${Math.random()*3}s`;
  $('#stars').appendChild(s);
}

// floating red hearts
const HCOL=['#ff0000','#e60000','#ff3333','#b30000'];
setInterval(()=>{
  if(current==='lock'||current==='home')return;
  const h=document.createElement('i');h.className='fh';h.textContent='♥';
  const sz=8+Math.random()*14;
  h.style.cssText=`left:${Math.random()*100}vw;font-size:${sz}px;color:${HCOL[Math.random()*HCOL.length|0]};--dx:${(Math.random()*2-1)*14}vw;--rt:${(Math.random()*2-1)*180}deg;animation-duration:${5+Math.random()*4}s;text-shadow:0 0 8px currentColor`;
  h.addEventListener('animationend',()=>h.remove());
  $('#hearts').appendChild(h);
},260);

function show(id){
  current=id;
  document.querySelectorAll('.scene').forEach(s=>s.classList.remove('active'));
  $('#'+id).classList.add('active');
  if(id==='letter'&&!started){started=true;startTyping();}
  if(id==='final')finalPlay();
}
$('#open-letter').addEventListener('click',()=>show('letter'));
$('#next-mem').addEventListener('click',()=>show('memories'));
$('#next-final').addEventListener('click',()=>show('final'));

// ending loop
let fT=null;
function finalPlay(){
  clearTimeout(fT);
  const f=$('#final');
  const seq=['p1','p2','p3','p4'];
  const dur=[1500,2000,1500,3200];
  let i=0;
  (function step(){
    f.dataset.phase=seq[i];
    fT=setTimeout(()=>{i=(i+1)%4;step();},dur[i]);
  })();
}

// ---- the romantic letter ----
const LETTER=[
"From the moment you came into my life, every ordinary day became something I look forward to. Your smile is my favorite sight, your voice is my favorite sound, and your heart is my favorite place in this world.",
"I don't need a perfect life, I just need you in mine. Through every storm and every sunny day, I will stand beside you, hold your hand, and love you a little more than yesterday, a little less than tomorrow.",
"You are not only the one I love, you are my peace, my home and my best friend. Wherever you are is where I belong. I choose you, today, tomorrow and always. ♥"
];
let started=false;
function startTyping(){
  const box=$('#letter-body');box.innerHTML='';
  const caret=document.createElement('span');caret.className='caret';
  let pi=0,ci=0,cur=null;
  (function tick(){
    if(pi>=LETTER.length){caret.remove();$('#next-mem').classList.add('show');return;}
    if(!cur){cur=document.createElement('p');box.appendChild(cur);cur.appendChild(caret);}
    const t=LETTER[pi];
    if(ci<t.length){cur.insertBefore(document.createTextNode(t[ci++]),caret);setTimeout(tick,14+Math.random()*14);}
    else{pi++;ci=0;cur=null;setTimeout(tick,400);}
  })();
}

// photos from the img folder: mem1 / mem2 / mem3
const PH='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 400"><rect width="300" height="400" fill="#181820"/><path d="M150 240c-30-28-60-48-60-84 0-24 20-40 40-40 12 0 20 6 20 14 0-8 8-14 20-14 20 0 40 16 40 40 0 36-30 56-60 84Z" fill="#e60000" opacity=".8"/><text x="150" y="300" fill="#8f93a3" font-size="14" text-anchor="middle" font-family="sans-serif">our memory</text></svg>`);
function loadImg(id,name){
  const list=[`img/${name}.png`,`img/${name}.jpg`,`img/${name}.jpeg`,`img/${name}.webp`,`img/${name}.gif`,`${name}.png`,`${name}.jpg`,`${name}.jpeg`,`${name}.webp`,`${name}.gif`];
  let i=0;(function n(){ if(i>=list.length){$('#'+id).src=PH;return;}
    const im=new Image();im.onload=()=>$('#'+id).src=list[i];im.onerror=()=>{i++;n();};im.src=list[i]; })();
}
loadImg('mem1','mem1');loadImg('mem2','mem2');loadImg('mem3','mem3');
</script>
