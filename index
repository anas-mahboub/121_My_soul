    <path class="leaf rl" style="animation-delay:1.5s" d="M129 420Q165 412 176 384Q140 392 129 410Z" fill="#2e7d4f"/>
    <g transform="translate(122,380) scale(.8)">
      <g class="head" style="animation-delay:1.9s">
        <g fill="#ffc44d">
          <g transform="rotate(-64)"><ellipse cy="-26" rx="14" ry="28"/></g>
          <g transform="rotate(-32)"><ellipse cy="-28" rx="14" ry="29"/></g>
          <ellipse cy="-30" rx="14" ry="29"/>
          <g transform="rotate(32)"><ellipse cy="-28" rx="14" ry="29"/></g>
          <g transform="rotate(64)"><ellipse cy="-26" rx="14" ry="28"/></g>
